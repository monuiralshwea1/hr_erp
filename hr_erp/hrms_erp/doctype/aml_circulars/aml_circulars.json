  },
  {
   "fieldname": "description",
   "fieldtype": "Text Editor",
   "label": "Description",
   "insert_after": "file"
  },
  {
   "fieldname": "permissions_section",
   "fieldtype": "Section Break",
   "label": "Permissions",
   "insert_after": "description"
  },
  {
   "fieldname": "is_private",
   "fieldtype": "Check",
   "label": "Is Private ?",
   "default": "0",
   "insert_after": "permissions_section"
  },
  {
   "fieldname": "only_to_department",
   "fieldtype": "Link",
   "label": "Only to Department",
   "options": "Department",
   "default": "الامتثال - SH",
   "insert_after": "is_private",
   "read_only": 1
  }
 ],
